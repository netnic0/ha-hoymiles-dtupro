# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.venv-poc/

# Build artifacts
build/
dist/
*.egg-info/
*.egg

# pytest / coverage / type checkers
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local secrets (never commit)
.env
.env.local
*.local
.ha_credentials*

# Home Assistant runtime artifacts (if user runs HA inside the dev container)
.devcontainer/config/.storage/
.devcontainer/config/home-assistant.log*
.devcontainer/config/*.db*
.devcontainer/config/.HA_VERSION
