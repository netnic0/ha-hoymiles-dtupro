# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.py        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.txt       text eol=lf
LICENSE     text eol=lf

# Binary files
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.zip       binary
